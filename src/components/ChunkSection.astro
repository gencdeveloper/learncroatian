---
import type { ChunkGroup } from "../lib/content";

interface Props {
  chunks: ChunkGroup[];
  sectionId?: string;
  heading?: string;
}

const { chunks, sectionId = "phrases", heading = "5. Everyday Phrases" } = Astro.props;
---

<section id={sectionId} class="scroll-mt-20 py-10">
  <h2 class="text-xl font-bold text-slate-900">{heading}</h2>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    {chunks.map((group) => (
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3 class="font-semibold text-slate-900">{group.context}</h3>
        <ul class="mt-3 space-y-2">
          {group.items.map((item) => (
            <li class="text-sm">
              <div class="font-medium text-slate-900">{item.hr}</div>
              <div class="text-slate-500">{item.en}</div>
              {item.note && <div class="mt-0.5 text-xs italic text-slate-400">{item.note}</div>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
