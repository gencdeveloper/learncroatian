---
import type { Story } from "../lib/content";
import { LEVEL_STYLES } from "../lib/content";
import SiteNav from "./SiteNav.astro";

interface Props {
  story: Story;
}

const { story } = Astro.props;
const style = LEVEL_STYLES[story.level];
---

<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto max-w-3xl px-6 py-4">
    <div class="flex items-center gap-3">
      <SiteNav />
      <span class={`rounded-full ${style.badge} px-2.5 py-0.5 text-xs font-bold uppercase text-white`}>{story.level}</span>
      <h1 class="text-lg font-bold text-slate-900">{story.title.en}</h1>
      <span class="text-sm text-slate-400">{story.title.hr}</span>
    </div>
  </div>
</header>

<main class="mx-auto max-w-3xl px-6 py-10">
  {story.topicsUsed.length > 0 && (
    <div class="mb-6 flex flex-wrap gap-2">
      {story.topicsUsed.map((t) => (
        <span class="rounded-full bg-purple-100 px-3 py-0.5 text-xs font-medium text-purple-700">{t}</span>
      ))}
    </div>
  )}

  <div class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    {story.paragraphs.map((p) => (
      <div>
        <p class="text-slate-900">{p.hr}</p>
        <details class="mt-1">
          <summary class="cursor-pointer text-sm text-blue-600">Show English translation</summary>
          <p class="mt-1 text-sm text-slate-500">{p.en}</p>
        </details>
      </div>
    ))}
  </div>

  {story.vocabulary && (
    <section class="mt-8 rounded-xl border border-slate-200 bg-slate-50 p-6">
      <h2 class="mb-4 text-base font-bold text-slate-800">Key Vocabulary</h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        <div>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Verbs</h3>
          <ul class="space-y-1.5">
            {story.vocabulary.verbs.map((v) => (
              <li class="text-sm">
                <span class="font-mono font-medium text-slate-900">{v.hr}</span>
                <span class="ml-2 text-slate-500">{v.en}</span>
                {v.note && <span class="ml-1 text-xs text-slate-400">({v.note})</span>}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Nouns</h3>
          <ul class="space-y-1.5">
            {story.vocabulary.nouns.map((v) => (
              <li class="text-sm">
                <span class="font-mono font-medium text-slate-900">{v.hr}</span>
                <span class="ml-2 text-slate-500">{v.en}</span>
                {v.note && <span class="ml-1 text-xs text-slate-400">({v.note})</span>}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Adjectives</h3>
          <ul class="space-y-1.5">
            {story.vocabulary.adjectives.map((v) => (
              <li class="text-sm">
                <span class="font-mono font-medium text-slate-900">{v.hr}</span>
                <span class="ml-2 text-slate-500">{v.en}</span>
                {v.note && <span class="ml-1 text-xs text-slate-400">({v.note})</span>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <a href="/" class="mt-8 inline-block text-sm font-medium text-slate-500 hover:text-blue-600">← Back to Home</a>
</main>
