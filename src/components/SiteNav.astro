---
const links = [
  { href: "/#a1", label: "A1" },
  { href: "/#a2", label: "A2" },
  { href: "/#b1", label: "B1" },
  { href: "/#b2", label: "B2" },
  { href: "/#stories", label: "Stories" },
  { href: "/#verb-reference", label: "Verb Reference" },
  { href: "/#cases", label: "Cases (Padeži)" },
  { href: "/#practice-tests", label: "Practice Tests" },
  { href: "/#phrase-collections", label: "Phrase Collections" },
];
---

<div class="flex items-center gap-1">
  <a href="/" class="flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-blue-600">
    ← Home
  </a>
  <details class="relative">
    <summary class="ml-1 cursor-pointer list-none rounded px-2 py-0.5 text-sm font-medium text-slate-500 hover:text-blue-600">
      Sections ▾
    </summary>
    <div class="absolute left-0 z-20 mt-1 w-56 rounded-lg border border-slate-200 bg-white py-1 shadow-lg">
      {links.map((link) => (
        <a href={link.href} class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-blue-600">
          {link.label}
        </a>
      ))}
    </div>
  </details>
</div>
