---
import type { VerbReference } from "../lib/content";
import SiteNav from "./SiteNav.astro";

interface Props {
  data: VerbReference;
}

const { data } = Astro.props;
---

<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto max-w-4xl px-6 py-4 flex items-center gap-3">
    <SiteNav />
    <h1 class="text-lg font-bold text-slate-900">{data.title.en}</h1>
  </div>
</header>

<main class="mx-auto max-w-4xl px-6 py-10">
  <p class="mb-6 text-slate-600">{data.intro}</p>

  <div class="mb-4">
    <input
      id="verb-search"
      type="text"
      placeholder="Search verbs..."
      class="w-full rounded-lg border border-slate-300 px-4 py-2 text-sm focus:border-blue-500 focus:outline-none"
    />
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200">
    <table class="w-full text-sm" id="verb-table">
      <thead class="bg-slate-700 text-white">
        <tr>
          <th class="px-4 py-3 text-left">Croatian (Infinitive)</th>
          <th class="px-4 py-3 text-left">English</th>
          <th class="px-4 py-3 text-left">Present (Prezent)</th>
          <th class="px-4 py-3 text-left">Past (Perfekt)</th>
          <th class="px-4 py-3 text-left">Future (Futur I)</th>
        </tr>
      </thead>
      <tbody>
        {data.verbs.map((v, i) => (
          <tr class={`verb-row ${i % 2 === 0 ? "bg-white" : "bg-slate-50"}`} data-hr={v.hr.toLowerCase()} data-en={v.en.toLowerCase()}>
            <td class="px-4 py-3 font-mono font-medium text-slate-900">{v.hr}</td>
            <td class="px-4 py-3 text-slate-600">{v.en}</td>
            <td class="px-4 py-3">
              <div class="font-medium text-slate-900">{v.prezent.hr}</div>
              <div class="text-xs text-slate-500">{v.prezent.en}</div>
            </td>
            <td class="px-4 py-3">
              <div class="font-medium text-slate-900">{v.perfekt.hr}</div>
              <div class="text-xs text-slate-500">{v.perfekt.en}</div>
            </td>
            <td class="px-4 py-3">
              <div class="font-medium text-slate-900">{v.futur.hr}</div>
              <div class="text-xs text-slate-500">{v.futur.en}</div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</main>

<script>
  const input = document.getElementById("verb-search") as HTMLInputElement;
  const rows = document.querySelectorAll<HTMLTableRowElement>(".verb-row");

  input?.addEventListener("input", () => {
    const q = input.value.toLowerCase().trim();
    rows.forEach((row) => {
      const match = !q || row.dataset.hr?.includes(q) || row.dataset.en?.includes(q);
      row.style.display = match ? "" : "none";
    });
  });
</script>
