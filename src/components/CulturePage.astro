---
import type { CultureGuide } from "../lib/content";
import SiteNav from "./SiteNav.astro";
import QuestionList from "./QuestionList.astro";

interface Props {
  data: CultureGuide;
}

const { data } = Astro.props;
---

<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto max-w-3xl px-6 py-4">
    <div class="flex items-center gap-3">
      <SiteNav />
      <h1 class="text-lg font-bold text-slate-900">{data.title.en}</h1>
    </div>
    <nav class="mt-3 flex flex-wrap gap-3 text-sm font-medium text-slate-500">
      {data.categories.map((c) => (
        <a href={`#${c.id}`} class="hover:text-rose-600">
          {c.icon} {c.title.en}
        </a>
      ))}
    </nav>
  </div>
</header>

<main class="mx-auto max-w-3xl px-6 py-10">
  <p class="mb-8 text-slate-600">{data.intro}</p>

  {data.categories.map((cat) => (
    <section id={cat.id} class="scroll-mt-20 mb-14">
      <div class="mb-5 flex items-center gap-3">
        <span class="text-2xl">{cat.icon}</span>
        <div>
          <h2 class="text-xl font-bold text-slate-900">{cat.title.en}</h2>
          <p class="text-sm text-slate-400">{cat.title.hr}</p>
        </div>
      </div>

      <div class="space-y-4">
        {cat.facts.map((fact, i) => (
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-medium text-slate-800">{fact.en}</p>
            <p class="mt-2 text-sm text-slate-500 italic">{fact.hr}</p>
          </div>
        ))}
      </div>

      {cat.quiz && cat.quiz.length > 0 && (
        <div class="mt-8 border-t border-slate-200 pt-6">
          <QuestionList
            sectionId={`${cat.id}-quiz`}
            heading={`Quiz: ${cat.title.en}`}
            questions={cat.quiz}
          />
        </div>
      )}
    </section>
  ))}
</main>
