---
import { LEVEL_STYLES, type Topic } from "../lib/content";
import GrammarSection from "./GrammarSection.astro";
import ReadingSection from "./ReadingSection.astro";
import QuestionList from "./QuestionList.astro";
import ChunkSection from "./ChunkSection.astro";
import SiteNav from "./SiteNav.astro";

interface Props {
  topic: Topic;
  prevTopic?: Topic;
  nextTopic?: Topic;
}

const { topic, prevTopic, nextTopic } = Astro.props;
const levelStyle = LEVEL_STYLES[topic.level];

const navLinks = [
  { href: "#grammar", label: "Grammar" },
  { href: "#reading", label: "Reading" },
  { href: "#comprehension", label: "Questions" },
  { href: "#test", label: "Test" },
  { href: "#phrases", label: "Phrases" },
];
---

<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto max-w-3xl px-6 py-4">
    <div class="flex items-center gap-3">
      <SiteNav />
      <span class={`rounded-full ${levelStyle.badge} px-2.5 py-0.5 text-xs font-bold uppercase text-white`}>
        {topic.level}
      </span>
      <h1 class="text-lg font-bold text-slate-900">{topic.title.en}</h1>
      <span class="text-sm text-slate-400">{topic.title.hr}</span>
    </div>
    <nav class="mt-3 flex gap-4 text-sm font-medium text-slate-500">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-blue-600">{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<main class="mx-auto max-w-3xl divide-y divide-slate-200 px-6">
  <GrammarSection grammar={topic.grammar} />
  <ReadingSection reading={topic.reading} />
  <QuestionList
    sectionId="comprehension"
    heading="3. Reading Comprehension Questions"
    questions={topic.readingQuestions}
  />
  <QuestionList
    sectionId="test"
    heading="4. Practice Test (25 Questions)"
    questions={topic.test}
  />
  <ChunkSection chunks={topic.chunks} />

  <nav class="flex items-center justify-between py-8">
    {prevTopic ? (
      <a href={`/topic/${prevTopic.level}/${prevTopic.id}`} class="group max-w-[45%] text-sm">
        <span class="text-slate-400">← Previous Topic</span>
        <div class="font-medium text-slate-700 group-hover:text-blue-600">{prevTopic.title.en}</div>
      </a>
    ) : <span />}
    {nextTopic ? (
      <a href={`/topic/${nextTopic.level}/${nextTopic.id}`} class="group max-w-[45%] text-right text-sm">
        <span class="text-slate-400">Next Topic →</span>
        <div class="font-medium text-slate-700 group-hover:text-blue-600">{nextTopic.title.en}</div>
      </a>
    ) : <span />}
  </nav>
</main>
