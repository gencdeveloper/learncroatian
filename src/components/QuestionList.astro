---
import type { QuestionMC } from "../lib/content";

interface Props {
  sectionId: string;
  heading: string;
  questions: (QuestionMC & { topicLabel?: string })[];
}

const { sectionId, heading, questions } = Astro.props;
---

<section id={sectionId} class="scroll-mt-20 py-10">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-slate-900">{heading}</h2>
    <div class="question-list-score rounded-full bg-slate-100 px-4 py-1 text-sm font-medium text-slate-600">
      Score: <span class="score-current">0</span>/<span class="score-total">{questions.length}</span>
    </div>
  </div>

  <div class="question-list mt-6 space-y-5">
    {questions.map((q) => (
      <fieldset class="question rounded-xl border border-slate-200 bg-white p-5 shadow-sm" data-correct-index={q.correctIndex}>
        {q.topicLabel && (
          <span class="mb-2 inline-block rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">
            {q.topicLabel}
          </span>
        )}
        <legend class="font-medium text-slate-900">{q.prompt}</legend>
        {q.promptHr && <p class="mt-1 font-mono text-sm text-slate-600">{q.promptHr}</p>}
        <div class="options mt-3 space-y-2">
          {q.options.map((opt, i) => (
            <label class="option flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm transition-colors">
              <input type="radio" name={q.id} value={i} class="accent-blue-600" />
              <span>{opt}</span>
            </label>
          ))}
        </div>
        {q.explanation && (
          <p class="explanation mt-3 hidden text-sm text-slate-500">{q.explanation}</p>
        )}
        <button type="button" class="retry-btn mt-3 hidden text-sm font-medium text-blue-600 hover:underline">
          ↻ Try again
        </button>
      </fieldset>
    ))}
  </div>

  <div class="completion-message mt-6 hidden rounded-xl border p-4 text-center text-sm font-semibold"></div>
</section>

<script>
  const MESSAGES = [
    { min: 0.9, text: "🏆 Outstanding! You've really mastered this topic.", style: "border-amber-300 bg-amber-50 text-amber-800" },
    { min: 0.75, text: "🎉 Excellent work! You're doing great, keep it up!", style: "border-emerald-300 bg-emerald-50 text-emerald-800" },
    { min: 0.5, text: "👍 Good progress! A few more practice rounds will make it perfect.", style: "border-blue-300 bg-blue-50 text-blue-800" },
    { min: 0, text: "💪 First attempt! No worries — use the retry buttons to practice more.", style: "border-slate-300 bg-slate-50 text-slate-700" },
  ];

  document.querySelectorAll<HTMLElement>(".question-list").forEach((list) => {
    const wrapper = list.closest("section");
    const scoreEl = wrapper?.querySelector(".score-current");
    const messageEl = wrapper?.querySelector<HTMLElement>(".completion-message");
    const total = list.querySelectorAll(".question").length;
    let score = 0;
    let answeredCount = 0;

    const updateCompletionMessage = () => {
      if (!messageEl) return;
      if (answeredCount < total) {
        messageEl.classList.add("hidden");
        return;
      }
      const ratio = total > 0 ? score / total : 0;
      const tier = MESSAGES.find((m) => ratio >= m.min) ?? MESSAGES[MESSAGES.length - 1];
      messageEl.textContent = `${tier.text} (${score}/${total})`;
      messageEl.className = `completion-message mt-6 rounded-xl border p-4 text-center text-sm font-semibold ${tier.style}`;
    };

    list.querySelectorAll<HTMLFieldSetElement>(".question").forEach((fieldset) => {
      const correctIndex = Number(fieldset.dataset.correctIndex);
      const inputs = Array.from(fieldset.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
      const retryBtn = fieldset.querySelector<HTMLButtonElement>(".retry-btn");

      inputs.forEach((input, i) => {
        input.addEventListener("change", () => {
          if (fieldset.dataset.answered) return;
          fieldset.dataset.answered = "true";

          inputs.forEach((inp, j) => {
            const label = inp.closest("label");
            inp.disabled = true;
            if (j === correctIndex) {
              label?.classList.add("border-green-500", "bg-green-50");
            } else if (j === i) {
              label?.classList.add("border-red-500", "bg-red-50");
            }
          });

          fieldset.querySelector(".explanation")?.classList.remove("hidden");
          retryBtn?.classList.remove("hidden");

          if (i === correctIndex) {
            score++;
            fieldset.dataset.countedCorrect = "true";
            if (scoreEl) scoreEl.textContent = String(score);
          }

          answeredCount++;
          updateCompletionMessage();
        });
      });

      retryBtn?.addEventListener("click", () => {
        delete fieldset.dataset.answered;
        answeredCount--;
        updateCompletionMessage();

        if (fieldset.dataset.countedCorrect) {
          delete fieldset.dataset.countedCorrect;
          score--;
          if (scoreEl) scoreEl.textContent = String(score);
        }

        inputs.forEach((inp) => {
          inp.disabled = false;
          inp.checked = false;
          inp.closest("label")?.classList.remove("border-green-500", "bg-green-50", "border-red-500", "bg-red-50");
        });

        fieldset.querySelector(".explanation")?.classList.add("hidden");
        retryBtn.classList.add("hidden");
      });
    });
  });
</script>
